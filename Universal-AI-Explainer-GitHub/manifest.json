{
  "manifest_version": 3,
  "name": "Universal AI Explainer",
  "version": "1.4.0",
  "description": "Explains text & code with Maya avatar, Jarvis Python Assistant Bridge, Live Talk voice, Side Panel, mentor personas, and 30s Page TL;DR.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "tabs",
    "storage",
    "scripting",
    "tts",
    "offscreen",
    "sidePanel"
  ],

  "host_permissions": [
    "http://localhost:3000/*",
    "http://localhost:8000/*",
    "http://localhost:11434/*",
    "http://127.0.0.1:3000/*",
    "http://127.0.0.1:8000/*",
    "http://127.0.0.1:11434/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js",
        "avatar-injector.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "commands": {
    "explain-selection": {
      "suggested_key": {
        "default": "Alt+E",
        "mac": "Alt+E"
      },
      "description": "Explain selected text with AI"
    }
  },
  "action": {
    "default_title": "Universal AI Explainer",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-modals; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdnjs.cloudflare.com https://cdn.jsdelivr.net http://127.0.0.1:* http://localhost:*; connect-src * 'self' blob: data: http://127.0.0.1:* http://localhost:*;"
  },
  "sandbox": {
    "pages": ["avatar-view.html"]
  },
  "web_accessible_resources": [
    {
      "resources": [
        "AvatarSample_A.vrm",
        "avatar-view.html",
        "lib/*",
        "vrm-avatar.js",
        "avatar-main.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}